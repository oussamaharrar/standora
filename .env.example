NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here
RECAPTCHA_SECRET=your_server_secret_here

# Waitlist provider: 'formspree' | 'webhook'
WAITLIST_PROVIDER=formspree

# If WAITLIST_PROVIDER=formspree
WAITLIST_FORMSPREE_ENDPOINT=https://formspree.io/f/XXXXXXXX

# If WAITLIST_PROVIDER=webhook
WAITLIST_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxxx/yyyyyy
WAITLIST_WEBHOOK_SECRET=optional_shared_secret
